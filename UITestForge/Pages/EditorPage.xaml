<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
   xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
   xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
   xmlns:edit="clr-namespace:ZPF.Maui.Script;assembly=ScriptPad"
   xmlns:controls="clr-namespace:ZPF.Maui.Script.Controls;assembly=ScriptPad"

   x:Class="ScriptPad.Sample.EditorPage">

   <Grid x:Name="bodyGrid" ColumnDefinitions="270,*" RowDefinitions="Auto,*">

      <!-- Status Bar - Caret Position and Modified Status -->
      <Border Grid.Column="0" Grid.Row="0" 
              BackgroundColor="#F0F0F0" 
              Padding="10,5"
              Margin="5,5,5,0">
         <HorizontalStackLayout Spacing="15">
            <Label x:Name="CaretPositionLabel" 
                   Text="Ln 1, Col 1" 
                   FontSize="12"
                   VerticalOptions="Center"/>
            <Label x:Name="ModifiedStatusLabel" 
                   Text="" 
                   FontSize="12"
                   TextColor="OrangeRed"
                   FontAttributes="Bold"
                   VerticalOptions="Center"/>
         </HorizontalStackLayout>
      </Border>

      <!-- File Explorer -->
      <controls:FileExplorerTreeView Grid.Column="0" Grid.Row="1" 
                                      x:Name="FileExplorer"
                                      RootPath=""
                                      FileExtensions="*"
                                      ShowSubfolders="True"
                                      FileSelected="OnFileSelected"
                                      Margin="5" />

      <!-- Toolbar -->
      <edit:ScriptPadToolbar Grid.Column="1" Grid.Row="0" 
                              x:Name="Toolbar"
                              Editor="{x:Reference EditorCtl}"
                              LoadRequested="OnLoadRequested"
                              SaveRequested="OnSaveRequested" />

      <!-- Editor -->
      <edit:ScriptPad Grid.Column="1" Grid.Row="1" 
                       x:Name="EditorCtl" 
                       WordWrap="False"
                       ShowLineNumbers="True"
                       EditorFontSize="14"
                       VerticalOptions="Fill"
                       HorizontalOptions="Fill" />
      
      <!--<edit:ScriptPad Grid.Column="1" Grid.Row="1"
                CustomMenuItemText="Send to AI"
                CustomMenuCommand="{Binding SendToAiCommand}" />-->
   </Grid>

</ContentPage>
