<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
xmlns:edit="clr-namespace:ZPF.Maui.Script;assembly=ScriptPad"
   
x:Class="UITestForge.MainPage"
Title="DevFlow Monitor">

   <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="0" RowSpacing="8">

      <!-- Row 0: Monitor start/stop controls -->
      <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">

         <HorizontalStackLayout Grid.Column="0" VerticalOptions="Center" Margin="20,0,10,0" >
            <Image Source="uitestforge.png" VerticalOptions="Start"/>
         </HorizontalStackLayout>

         <!-- Col 1: Agent picker -->
         <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
            <Label x:Name="StatusLabel"
                   Text="{Binding StatusText}"
                   LineBreakMode="WordWrap" />

            <Picker x:Name="AgentsPicker"
                    ItemsSource="{Binding Agents}"
                    ItemDisplayBinding="{Binding DisplayName}"
                    SelectedIndexChanged="OnAgentSelectionChanged" />
         </VerticalStackLayout>

         <Button x:Name="RefreshAgentsBtn" Grid.Column="2" Margin="0,20,0,10"
                       Text="↻"
                       FontSize="24"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light=#FFFFFF, Dark=#000000}"
                 AutomationId="RefreshAgentsBtn"
                 Command="{Binding RefreshAgentsCommand}"
                 ToolTipProperties.Text="Manually refresh the agent list"
                 HeightRequest="55"
                 WidthRequest="55" />

         <!-- Col 3: Selected agent details -->
         <Border x:Name="SelectedAgentFrame" Grid.Column="3" Margin="0,10,10,0"
                  Padding="12"
                  StrokeThickness="0"
                  BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
                  IsVisible="{Binding SelectedAgentFrameVisible}">
            <Border.StrokeShape>
               <RoundRectangle CornerRadius="8"/>
            </Border.StrokeShape>
            <Border.Shadow>
               <Shadow Brush="Black" Opacity="0.3" Radius="4" Offset="0,2"/>
            </Border.Shadow>

            <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="4">
               <Label x:Name="SelectedAgentAppName"
                         Grid.Row="0"
                         Text="{Binding SelectedAgentAppName}"
                         FontAttributes="Bold"
                         FontSize="16" />
               <Label x:Name="SelectedAgentPlatform"
                         Grid.Row="1"
                         Text="{Binding SelectedAgentPlatform}"
                         FontSize="13"
                         TextColor="{AppThemeBinding Light=Gray, Dark=LightGray}" />
               <Label x:Name="SelectedAgentTfm"
                         Grid.Row="2"
                         Text="{Binding SelectedAgentTfm}"
                         FontSize="12"
                         TextColor="{AppThemeBinding Light=Gray, Dark=LightGray}" />

               <Label x:Name="SelectedAgentConnectedAt" IsVisible="False"
                         Grid.Row="3"
                         Text="{Binding SelectedAgentConnectedAt}"
                         FontSize="11"
                         TextColor="{AppThemeBinding Light=DarkGray, Dark=Silver}" />
            </Grid>
         </Border>

      </Grid>

      <!-- Row 1: Action toolbar (Screenshot + Tree, enabled when agent is selected) -->
      <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,Auto,*" ColumnSpacing="8" Margin="5,0,0,0">

         <Button x:Name="TapCounterBtn"
                  Grid.Column="0"
                  Text="👆 Tap CounterBtn"
                  AutomationId="TapCounterBtn"
                  Command="{Binding TapCounterButtonCommand}"
                  IsVisible="False"
                  IsEnabled="{Binding TapCounterEnabled}" />

         <Button x:Name="AdbForwardBtn"
                  Grid.Column="1"
                  Text="🔗 ADB Forward"
                  AutomationId="AdbForwardBtn"
                  Command="{Binding AdbForwardCommand}"
                  ToolTipProperties.Text="Run adb reverse tcp:19223 tcp:19223 on emulator-5554 so the Android DevFlow agent can reach the broker" />

         <Label x:Name="ActionStatusLabel"
                Grid.Column="2"
                Text="{Binding ActionStatusText}"
                VerticalOptions="Center"
                FontSize="12"
                TextColor="{AppThemeBinding Light=Gray, Dark=LightGray}" />

         <ActivityIndicator x:Name="Busy"
                            Grid.Column="3"
                            IsRunning="{Binding IsBusy}"
                            IsVisible="{Binding IsBusy}"
                            Color="{StaticResource Primary}"
                            WidthRequest="24"
                            HeightRequest="24"
                            VerticalOptions="Center" />
      </Grid>

      <!-- Row 2: 3-column panel — screenshot | tree | node detail -->
      <Grid Grid.Row="2" ColumnDefinitions="*,*,*" ColumnSpacing="12" Margin="10,0,10,10">

         <!-- Col 0: Screenshot image -->
         <Border Grid.Column="0" 
                 Padding="10"
                 BackgroundColor="{AppThemeBinding Light=#Fddd, Dark=#1E1E1E}" >
            <Border.StrokeShape>
               <RoundRectangle CornerRadius="8"/>
            </Border.StrokeShape>
            <Border.Shadow>
               <Shadow Brush="Black" Opacity="0.3" Radius="4" Offset="0,2"/>
            </Border.Shadow>

            <Grid>
               <Image x:Name="ScreenshotImage"
                   IsVisible="{Binding ScreenshotImageVisible}"
                   Aspect="AspectFit"
                   HorizontalOptions="Fill"
                   VerticalOptions="Fill">
                  <FlyoutBase.ContextFlyout>
                     <MenuFlyout>
                        <MenuFlyoutItem Text="Copy to Clipboard"
                                        Clicked="OnCopyScreenshotClicked" />
                     </MenuFlyout>
                  </FlyoutBase.ContextFlyout>
               </Image>

               <!-- Refresh button overlay -->
               <Button x:Name="ScreenshotRefreshBtn"
                       Text="↻"
                       FontSize="24"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light=#000000, Dark=#FFFFFF}"
                       WidthRequest="40"
                       HeightRequest="40"
                       CornerRadius="20"
                       BackgroundColor="{AppThemeBinding Light=#D5DBEB, Dark=#2D2D2D}"
                       BorderColor="{AppThemeBinding Light=#CCCCCC, Dark=#555555}"
                       BorderWidth="1"
                       Opacity="0.7"
                       HorizontalOptions="End"
                       VerticalOptions="Start"
                       Margin="10"
                       Padding="0"
                       IsVisible="{Binding ScreenshotRefreshButtonVisible}"
                       Command="{Binding TakeScreenshotCommand}"
                       ToolTipProperties.Text="Refresh screenshot" />
            </Grid>

         </Border>

         <!-- Col 1: Hierarchical tree view -->
         <Border Grid.Column="1"
                 Padding="10"
                 BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}" >
            <Border.StrokeShape>
               <RoundRectangle CornerRadius="8"/>
            </Border.StrokeShape>
            <Border.Shadow>
               <Shadow Brush="Black" Opacity="0.3" Radius="4" Offset="0,2"/>
            </Border.Shadow>

            <Grid x:Name="TreeColumn" RowDefinitions="*,auto"
               RowSpacing="4"
               IsVisible="{Binding TreeColumnVisible}" >

               <!-- Tree node list -->
               <CollectionView x:Name="TreeView"
                            ItemSizingStrategy="MeasureAllItems"
                            Grid.Row="0"
                            ItemsSource="{Binding TreeItems}"
                            SelectionMode="Single"
                            SelectionChanged="OnTreeNodeSelected"
                            EmptyView="Tree not loaded — Select an agent">
                  <CollectionView.ItemTemplate>
                     <DataTemplate>
                        <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto"
                              ColumnSpacing="3"
                              Padding="{Binding IndentPadding}"
                              HeightRequest="26">
                           <Grid.GestureRecognizers>
                              <TapGestureRecognizer NumberOfTapsRequired="2"
                                                      CommandParameter="{Binding}"
                                                      Tapped="OnTreeNodeDoubleTapped" />
                           </Grid.GestureRecognizers>

                           <!-- Expand / collapse toggle -->
                           <Label Grid.Column="0"
                               Text="{Binding ExpandIcon}"
                               FontSize="13"
                               WidthRequest="16"
                               VerticalOptions="Center">
                              <Label.GestureRecognizers>
                                 <TapGestureRecognizer CommandParameter="{Binding}"
                                                    Tapped="OnExpandToggled" />
                              </Label.GestureRecognizers>
                           </Label>

                           <!-- Type icon -->
                           <Label Grid.Column="1"
                               Text="{Binding TypeIcon}"
                               FontSize="12"
                               VerticalOptions="Center" />

                           <!-- Short type name -->
                           <Label Grid.Column="2"
                               Text="{Binding DisplayType}"
                               FontSize="11"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#0066CC, Dark=#66AAFF}"
                               VerticalOptions="Center" />

                           <!-- AutomationId / text / empty -->
                           <Label Grid.Column="3"
                               Text="{Binding DisplayLabel}"
                               FontSize="11"
                               TextColor="{AppThemeBinding Light=#555555, Dark=#AAAAAA}"
                               LineBreakMode="TailTruncation"
                               VerticalOptions="Center" />

                           <!-- "hidden" badge -->
                           <Label Grid.Column="4"
                               Text="hidden"
                               FontSize="9"
                               TextColor="Gray"
                               VerticalOptions="Center"
                               HorizontalOptions="End"
                               IsVisible="{Binding IsHiddenNode}" />
                        </Grid>
                     </DataTemplate>
                  </CollectionView.ItemTemplate>
               </CollectionView>

               <!-- Selected-node detail panel -->
               <!-- Row 1: Node detail panel -->
               <Border x:Name="NodeDetailFrame"
                    Grid.Row="1"
                    Padding="10"
                    StrokeThickness="0"
                  BackgroundColor="{AppThemeBinding Light=#D5DBEB, Dark=#1A2035}"
                  IsVisible="{Binding NodeDetailFrameVisible}">
                  <Border.StrokeShape>
                     <RoundRectangle CornerRadius="8"/>
                  </Border.StrokeShape>
                  <Border.Shadow>
                     <Shadow Brush="Black" Opacity="0.2" Radius="8" Offset="0,2"/>
                  </Border.Shadow>

                  <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="2">
                     <Label Grid.Row="0"
                         Text="{Binding SelectedTreeNode.FullTypeLabel}"
                         FontAttributes="Bold"
                         FontSize="12" />
                     <Label Grid.Row="1"
                         Text="{Binding SelectedTreeNode.IdLabel}"
                         FontSize="10"
                         TextColor="{AppThemeBinding Light=Gray, Dark=LightGray}" />
                     <Label Grid.Row="2"
                         Text="{Binding SelectedTreeNode.AutomationIdLabel}"
                         FontSize="11"
                         IsVisible="{Binding SelectedTreeNode.HasAutomationId}" />
                     <Label Grid.Row="3"
                         Text="{Binding SelectedTreeNode.TextLabel}"
                         FontSize="11"
                         IsVisible="{Binding SelectedTreeNode.HasText}" />
                     <Label Grid.Row="4"
                         Text="{Binding SelectedTreeNode.BoundsLabel}"
                         FontSize="10"
                         TextColor="{AppThemeBinding Light=DimGray, Dark=Silver}" />
                     <Label Grid.Row="5"
                         Text="{Binding SelectedTreeNode.StateLabel}"
                         FontSize="10"
                         TextColor="{AppThemeBinding Light=DimGray, Dark=Silver}" />
                  </Grid>

               </Border>

               <!-- Refresh button overlay -->
               <Button x:Name="TreeViewRefreshBtn"
                       Text="↻"
                       FontSize="24"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light=#000000, Dark=#FFFFFF}"
                       WidthRequest="40"
                       HeightRequest="40"
                       CornerRadius="20"
                       BackgroundColor="{AppThemeBinding Light=#D5DBEB, Dark=#2D2D2D}"
                       BorderColor="{AppThemeBinding Light=#CCCCCC, Dark=#555555}"
                       BorderWidth="1"
                       Opacity="0.7"
                       HorizontalOptions="End"
                       VerticalOptions="Start"
                       Margin="10"
                       Padding="0"
                       IsVisible="{Binding TreeViewRefreshButtonVisible}"
                       Command="{Binding RefreshTreeCommand}"
                       ToolTipProperties.Text="Refresh TreeView" />
            </Grid>
         </Border>

         <!-- Col 2: Script editor -->
         <Border x:Name="scriptEditor" Grid.Column="2" 
                 Padding="5"
                 BackgroundColor="{AppThemeBinding Light=#Fddd, Dark=#1E1E1E}" >
            <Border.StrokeShape>
               <RoundRectangle CornerRadius="8"/>
            </Border.StrokeShape>
            <Border.Shadow>
               <Shadow Brush="Black" Opacity="0.3" Radius="4" Offset="0,2"/>
            </Border.Shadow>

            <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" RowSpacing="4">

               <!-- Header -->
               <Grid ColumnDefinitions="*,*" Grid.Row="0">

                  <Label Grid.Row="0"
                      Text="📝 Script Editor"
                      FontAttributes="Bold"
                      FontSize="14"
                      VerticalOptions="Center"
                      Margin="0,0,0,2" />

                  <!-- Syntax Helper Button -->
                  <Button Grid.Column="1"
                       Text="📖 Syntax Helper"
                       FontSize="11"
                       HorizontalOptions="End"
                       Clicked="OnShowSyntaxHelperClicked" />

               </Grid>

               <!-- Script text editor -->
               <Border Grid.Row="2"
                       BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
                       StrokeThickness="1"
                       Stroke="{AppThemeBinding Light=LightGray, Dark=#444}">
                  <Border.StrokeShape>
                     <RoundRectangle CornerRadius="4" />
                  </Border.StrokeShape>
                  
                  <!--<Editor x:Name="ScriptEditor"
                          FontFamily="Courier New"
                          FontSize="13"
                          Placeholder="# Write your devflow script here&#x0a;# Available commands: tap, fill, clear, focus, navigate, scroll, screenshot&#x0a;# Example:&#x0a;tap MyButton&#x0a;fill MyEntry Hello&#x0a;screenshot"
                          AutoSize="TextChanges"
                          VerticalOptions="Fill"
                          IsSpellCheckEnabled="False"
                          Margin="4" />-->

                  <edit:ScriptPad x:Name="ScriptEditor" 
                       WordWrap="False"
                       ShowLineNumbers="True"
                       EditorFontSize="13"
                       VerticalOptions="Fill"
                       HorizontalOptions="Fill" />
                  
               </Border>

               <!-- Run / Clear buttons -->
               <Grid Grid.Row="3" RowDefinitions="auto,auto" ColumnDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="6" Margin="0,2,0,0">

                  <Button x:Name="ScriptLoadBtn"
                          Grid.Column="0"
                          Text="📂 Load"
                          FontSize="12"
                          Padding="8,4"
                          Clicked="OnScriptLoadClicked" />
                  <Button x:Name="ScriptSaveBtn"
                          Grid.Column="1"
                          Text="💾 Save"
                          FontSize="12"
                          Padding="8,4"
                          Clicked="OnScriptSaveClicked" />
                  <Button x:Name="ScriptClearBtn"
                          Grid.Column="2"
                          Text="🗑 Clear"
                          FontSize="12"
                          Padding="8,4"
                          Clicked="OnScriptClearClicked" />
                  <Button x:Name="ScriptRunBtn"
                          Grid.Column="3"
                          Text="▶ Run"
                          FontSize="12"
                          Padding="8,4"
                          Clicked="OnScriptRunClicked" />

                  <Label x:Name="ScriptStatusLabel"
                         Grid.Row="1" Grid.ColumnSpan="4"
                         Text="{Binding ScriptStatusText}"
                         VerticalOptions="Center"
                         FontSize="12"
                         TextColor="{AppThemeBinding Light=Gray, Dark=LightGray}"
                         LineBreakMode="TailTruncation" />
               </Grid>

               <!-- Output log -->
               <Border x:Name="ScriptOutputBorder" Grid.Row="4"
                       HeightRequest="130"
                       SizeChanged="OnScriptOutputBorderSizeChanged"
                       BackgroundColor="{AppThemeBinding Light=#F0F0F0, Dark=#111}"
                       StrokeThickness="1"
                       Stroke="{AppThemeBinding Light=LightGray, Dark=#444}">
                  <Border.StrokeShape>
                     <RoundRectangle CornerRadius="4" />
                  </Border.StrokeShape>

                     <ScrollView Orientation="Both"
                                 HorizontalScrollBarVisibility="Always"
                                 VerticalScrollBarVisibility="Always">
                        <Editor x:Name="ScriptOutputLabel"
                              FontFamily="Courier New"
                              FontSize="11"
                              IsSpellCheckEnabled="False"
                              IsReadOnly="True"
                              Margin="6,4"
                              HorizontalOptions="Start"
                              VerticalOptions="Start"
                              MinimumHeightRequest="120"
                              AutoSize="TextChanges"
                              Text="{Binding ScriptOutputText}"
                              Placeholder="(output will appear here)" />
                     </ScrollView>
                  </Border>

            </Grid>

         </Border>

      </Grid>

   </Grid>

</ContentPage>
