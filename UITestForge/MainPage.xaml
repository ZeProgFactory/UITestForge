<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="UITestForge.MainPage"
             Title="DevFlow Monitor">

   <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="0" RowSpacing="8">

      <!-- Row 0: Monitor start/stop controls -->
      <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
         
         <HorizontalStackLayout Grid.Column="0" VerticalOptions="Center" Margin="20,0,10,0" >
            <Image Source="uitestforge.png" VerticalOptions="Start"/>
         </HorizontalStackLayout>

         <!-- Col 1: Agent picker -->
         <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
            <Label x:Name="StatusLabel"
                Text="Idle — press Start to monitor"
                
                LineBreakMode="WordWrap" />

            <Picker x:Name="AgentsPicker"
                    ItemsSource="{Binding Agents}"
                    ItemDisplayBinding="{Binding DisplayName}"
                    SelectedIndexChanged="OnAgentSelectionChanged" />
         </VerticalStackLayout>

         <Button x:Name="MonitorBtn" Grid.Column="2" Margin="0,20,0,20"
                 Text="Start"
                 AutomationId="MonitorBtn"
                 Clicked="OnMonitorClicked"
                 WidthRequest="80" />
         
         <!-- Col 3: Selected agent details -->
         <Border x:Name="SelectedAgentFrame" Grid.Column="3" Margin="0,10,10,0"
                 Padding="12"
                    StrokeThickness="0"
                    BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
                    IsVisible="False">
            <Border.StrokeShape>
               <RoundRectangle CornerRadius="8"/>
            </Border.StrokeShape>
            <Border.Shadow>
               <Shadow Brush="Black" Opacity="0.3" Radius="4" Offset="0,2"/>
            </Border.Shadow>
            <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="4">
               <Label x:Name="SelectedAgentAppName"
                         Grid.Row="0"
                         FontAttributes="Bold"
                         FontSize="16" />
               <Label x:Name="SelectedAgentPlatform"
                         Grid.Row="1"
                         FontSize="13"
                         TextColor="{AppThemeBinding Light=Gray, Dark=LightGray}" />
               <Label x:Name="SelectedAgentTfm"
                         Grid.Row="2"
                         FontSize="12"
                         TextColor="{AppThemeBinding Light=Gray, Dark=LightGray}" />
               <Label x:Name="SelectedAgentConnectedAt"
                         Grid.Row="3"
                         FontSize="11"
                         TextColor="{AppThemeBinding Light=DarkGray, Dark=Silver}" />
            </Grid>
         </Border>

      </Grid>

      <!-- Row 1: Action toolbar (Screenshot + Tree, enabled when agent is selected) -->
      <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto" ColumnSpacing="8" Margin="10,0,0,0">

         <Button x:Name="ScreenshotBtn"
                 Grid.Column="0"
                 Text="📷 Screenshot"
                 AutomationId="ScreenshotBtn"
                 Clicked="OnScreenshotClicked"
                 IsEnabled="False" />

         <Button x:Name="TreeBtn"
                 Grid.Column="1"
                 Text="🌳 Tree"
                 AutomationId="TreeBtn"
                 Clicked="OnTreeClicked"
                 IsEnabled="False" />

         <Button x:Name="TapCounterBtn"
                 Grid.Column="2"
                 Text="👆 Tap CounterBtn"
                 AutomationId="TapCounterBtn"
                 Clicked="OnTapCounterBtnClicked"
                 IsEnabled="False" />

         <Button x:Name="AdbForwardBtn"
                 Grid.Column="3"
                 Text="🔗 ADB Forward"
                 AutomationId="AdbForwardBtn"
                 Clicked="OnAdbForwardClicked"
                 ToolTipProperties.Text="Run adb reverse tcp:19223 tcp:19223 on emulator-5554 so the Android DevFlow agent can reach the broker" />
         <Label x:Name="ActionStatusLabel"
                Grid.Column="4"
                Text="Select an agent below"
                VerticalOptions="Center"
                FontSize="12"
                TextColor="{AppThemeBinding Light=Gray, Dark=LightGray}" />

         <ActivityIndicator x:Name="Busy"
                            Grid.Column="5"
                            IsRunning="False"
                            IsVisible="False"
                            Color="{StaticResource Primary}"
                            WidthRequest="24"
                            HeightRequest="24"
                            VerticalOptions="Center" />
      </Grid>

      <!-- Row 2: 3-column panel — agents | screenshot | tree -->
      <Grid Grid.Row="2" ColumnDefinitions="*,*,*" Margin="10,0,0,10">

         <!-- Col 1: Screenshot image -->
         <Image x:Name="ScreenshotImage"
                Grid.Column="0"
                IsVisible="False"
                Aspect="AspectFit"
                HorizontalOptions="Fill"
                VerticalOptions="Fill" />

         <!-- Col 2: Hierarchical tree view -->
         <Grid x:Name="TreeColumn"
               Grid.Column="1"
               RowDefinitions="*,Auto"
               RowSpacing="4"
               IsVisible="False">

            <!-- Tree node list -->
            <CollectionView x:Name="TreeView"
                            Grid.Row="0"
                            ItemsSource="{Binding TreeItems}"
                            SelectionMode="Single"
                            SelectionChanged="OnTreeNodeSelected"
                            EmptyView="Tree not loaded — press 🌳 Tree">
               <CollectionView.ItemTemplate>
                  <DataTemplate>
                     <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto"
                           ColumnSpacing="3"
                           Padding="{Binding IndentPadding}"
                           HeightRequest="26">

                        <!-- Expand / collapse toggle -->
                        <Label Grid.Column="0"
                               Text="{Binding ExpandIcon}"
                               FontSize="13"
                               WidthRequest="16"
                               VerticalOptions="Center">
                           <Label.GestureRecognizers>
                              <TapGestureRecognizer CommandParameter="{Binding}"
                                                    Tapped="OnExpandToggled" />
                           </Label.GestureRecognizers>
                        </Label>

                        <!-- Type icon -->
                        <Label Grid.Column="1"
                               Text="{Binding TypeIcon}"
                               FontSize="12"
                               VerticalOptions="Center" />

                        <!-- Short type name -->
                        <Label Grid.Column="2"
                               Text="{Binding DisplayType}"
                               FontSize="11"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#0066CC, Dark=#66AAFF}"
                               VerticalOptions="Center" />

                        <!-- AutomationId / text / empty -->
                        <Label Grid.Column="3"
                               Text="{Binding DisplayLabel}"
                               FontSize="11"
                               TextColor="{AppThemeBinding Light=#555555, Dark=#AAAAAA}"
                               LineBreakMode="TailTruncation"
                               VerticalOptions="Center" />

                        <!-- "hidden" badge -->
                        <Label Grid.Column="4"
                               Text="hidden"
                               FontSize="9"
                               TextColor="Gray"
                               VerticalOptions="Center"
                               HorizontalOptions="End"
                               IsVisible="{Binding IsHiddenNode}" />
                     </Grid>
                  </DataTemplate>
               </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Selected-node detail panel -->
            <Border x:Name="NodeDetailFrame"
                    Grid.Row="1"
                    IsVisible="False"
                    Padding="10,8"
                    StrokeThickness="0"
                    BackgroundColor="{AppThemeBinding Light=#EEF4FF, Dark=#1A2035}">
               <Border.StrokeShape>
                  <RoundRectangle CornerRadius="6"/>
               </Border.StrokeShape>
               <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="2">
                  <Label Grid.Row="0"
                         Text="{Binding SelectedTreeNode.FullTypeLabel}"
                         FontAttributes="Bold"
                         FontSize="12" />
                  <Label Grid.Row="1"
                         Text="{Binding SelectedTreeNode.IdLabel}"
                         FontSize="10"
                         TextColor="{AppThemeBinding Light=Gray, Dark=LightGray}" />
                  <Label Grid.Row="2"
                         Text="{Binding SelectedTreeNode.AutomationIdLabel}"
                         FontSize="11"
                         IsVisible="{Binding SelectedTreeNode.HasAutomationId}" />
                  <Label Grid.Row="3"
                         Text="{Binding SelectedTreeNode.TextLabel}"
                         FontSize="11"
                         IsVisible="{Binding SelectedTreeNode.HasText}" />
                  <Label Grid.Row="4"
                         Text="{Binding SelectedTreeNode.BoundsLabel}"
                         FontSize="10"
                         TextColor="{AppThemeBinding Light=DimGray, Dark=Silver}" />
                  <Label Grid.Row="5"
                         Text="{Binding SelectedTreeNode.StateLabel}"
                         FontSize="10"
                         TextColor="{AppThemeBinding Light=DimGray, Dark=Silver}" />
               </Grid>
            </Border>

         </Grid>

      </Grid>

   </Grid>

</ContentPage>
