<?xml version="1.0" encoding="utf-8"?>
<!--
    Allows plain HTTP to the Android emulator host alias (10.0.2.2) so the
    UITestForge app can reach the DevFlow broker running on the dev machine.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
